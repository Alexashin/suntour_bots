APP_ENV=dev
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://suntour:suntour@db:5432/suntour

TELEGRAM_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ENABLE_POLLING=true
# Локальная разработка в РФ, пример:
# TELEGRAM_PROXY=socks5://host.docker.internal:10808
# На зарубежном production-сервере обычно оставить пустым.
TELEGRAM_PROXY=

MAX_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
# dev: polling; production: webhook
MAX_MODE=polling
MAX_ADMIN_USER_IDS=
MAX_ADMIN_CHAT_IDS=
MAX_MARKETING_BROADCAST_ENABLED=false
MAX_WEBHOOK_SECRET=change_me_please
PUBLIC_DOMAIN=

# Не превышаем ограничения платформ при последовательной рассылке.
BROADCAST_DELAY_SECONDS=0.55
